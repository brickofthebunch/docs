      "redirect": false,
      "title": "We can't find that page",
      "description": "The page you're looking for may have moved or no longer exists. Try searching the BrickDeck Help Centre, or head back to the homepage"
    }
  },
  "variables": {
    "productName": "BrickDeck",
    "appUrl": "https://app.brickdeck.app",
